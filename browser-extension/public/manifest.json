{
  "manifest_version": 3,
  "name": "__MSG_app_name__",
  "version": "1.0.0",
  "description": "__MSG_app_description__",
  "default_locale": "en",
  "icons": {
    "16": "nexus-ai-icon-16.png",
    "32": "nexus-ai-icon-32.png",
    "48": "nexus-ai-icon-48.png",
    "128": "nexus-ai-icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "nexus-ai-icon-16.png",
      "32": "nexus-ai-icon-32.png",
      "48": "nexus-ai-icon-48.png",
      "128": "nexus-ai-icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"]
    }
  ]
}
