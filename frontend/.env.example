VITE_API_BASE='/api' # Same origin as the page. In dev the vite proxy forwards this to the backend (see vite.config.js); in docker the server serves both the SPA and the API on one port.
# VITE_API_BASE='http://localhost:3001/api' # Point the browser straight at the backend instead of proxying. Only reachable from this machine, so `yarn dev --host` will not work for other devices.
# VITE_API_BASE="https://$CODESPACE_NAME-3001.$GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN/api" # for GitHub Codespaces
