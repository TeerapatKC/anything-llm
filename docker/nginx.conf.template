# Frontend container for the split (frontend/backend) AnythingLLM deployment.
# ${BACKEND_HOST}/${BACKEND_PORT} are substituted on container boot by the nginx
# entrypoint from the environment (defaults: backend:3001).

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name _;

  # Resolve the backend per-request through Docker's embedded DNS instead of once
  # at boot. Without this nginx refuses to start when the backend container is not
  # up yet, and keeps a stale IP after the backend is recreated.
  resolver ${DNS_RESOLVER} valid=10s ipv6=off;
  set $backend_url "http://${BACKEND_HOST}:${BACKEND_PORT}";

  root /usr/share/nginx/html;
  index index.html;

  # Matches the FILE_LIMIT used by the express server so large uploads are not
  # rejected by the proxy before they ever reach the backend.
  client_max_body_size 3G;
  proxy_request_buffering off;

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  # Disable I-framing of the entire site UI - same header the express server sets
  add_header X-Frame-Options "DENY" always;

  # API + agent websockets (/api/agent-invocation/:id) -> backend container
  location /api/ {
    proxy_pass $backend_url;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Chat/agent responses are streamed - never buffer them and allow long-lived
    # connections for slow LLM providers and large document uploads.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  # PWA manifest is generated on the fly by the backend (custom app name/icon)
  location = /manifest.json {
    proxy_pass $backend_url;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /robots.txt {
    add_header Content-Type text/plain;
    return 200 "User-agent: *\nDisallow: /\n";
  }

  # Hashed assets are content-addressed, index.{js,css} are not
  location ~* \.(png|jpg|jpeg|gif|svg|ico|woff2?|ttf|wasm|onnx)$ {
    expires 30d;
    add_header Cache-Control "public, immutable";
  }

  # SPA fallback - every other route is client-side routed
  location / {
    try_files $uri $uri/ /index.html;
  }
}
