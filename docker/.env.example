SERVER_PORT=3001
###########################################
######## PERSISTENT STORAGE ###############
###########################################
# REQUIRED. Where the instance keeps everything it owns: the SQLite database, embedded
# documents and the vector cache. Docker mounts it at STORAGE_DIR below. It has no
# default on purpose - state kept inside this repository is destroyed by a
# `git clean -xfd` on the deploy checkout, or lost when the checkout is replaced.
#
# Two forms are accepted, and the same compose file serves both:
#
#   1. A docker volume name. Docker owns the storage and it survives every container
#      rebuild. On Windows and macOS this is also much faster, because the data lives
#      inside the Linux VM instead of crossing the filesystem boundary on every write.
#      Note that `docker compose down -v` deletes it.
#
#        STORAGE_LOCATION=nexusai-storage
#
#   2. A host directory, for when operations wants the data at a known path it can
#      snapshot or back up with ordinary tools. Must be LOCAL disk - SQLite locking is
#      not safe over NFS or SMB - and must sit outside this repository.
#
#        STORAGE_LOCATION=/var/lib/nexusai/storage
#
STORAGE_LOCATION=nexusai-storage

# The embedder, reranker, transcription model and OCR data. Not in the app image:
# the nexusai-models job fetches them into a docker volume, and the app mounts it
# read-only. An offline bundle points this at its models/nexusai instead.
# NEXUSAI_MODELS_DIR='/path/to/bundle/models/nexusai'

STORAGE_DIR="/app/server/storage"
UID='1000'
GID='1000'
# SIG_KEY='passphrase' # Please generate random string at least 32 chars long.
# SIG_SALT='salt' # Please generate random string at least 32 chars long.
# JWT_SECRET="my-random-string-for-seeding" # Signs user session tokens. Generated automatically on first boot if unset; set it explicitly to keep sessions valid across redeploys. At least 12 chars long.
# JWT_EXPIRY="30d" # (optional)

# Backend-only brand identity preamble prepended to every chat/agent system prompt.
# Never shown in the UI - users cannot see or edit it from the Default System Prompt page.
# BRAND_IDENTITY_PROMPT="You are NexusAI, ..."
# DISABLE_BRAND_IDENTITY_PROMPT="true" # Turn the preamble off entirely.

###########################################
######## LLM API SELECTION ################
###########################################
# Only the Generic OpenAI-compatible LLM service is supported.
# LLM_PROVIDER='generic-openai'
# With the llama.cpp overlay, leave BASE_PATH unset to use http://llamacpp:8080/v1.
# With only docker-compose.yml, set BASE_PATH to any OpenAI-compatible /v1 URL.
# Example test service: https://llama-cpp.zenflowai.app/v1 (currently reports qwen27b).
# GENERIC_OPEN_AI_BASE_PATH='https://llama-cpp.zenflowai.app/v1'
# GENERIC_OPEN_AI_MODEL_PREF='qwen27b' # Must be an ID returned by that URL's /models endpoint.
# GENERIC_OPEN_AI_API_KEY='unused' # Replace with a real key if the service requires one.
# GENERIC_OPEN_AI_ALLOWED_MODELS= # Optional comma-separated filter; blank shows every live model.
# GENERIC_OPEN_AI_MODEL_TOKEN_LIMIT=4096

###########################################
######## Embedding API Selection ##########
###########################################
# Choose one provider in the server environment. The settings page cannot change it.
# Built-in uses MintplexLabs/multilingual-e5-small, bundled into the Docker image at build time.
# EMBEDDING_ENGINE='native'

# Generic OpenAI-compatible embedding service. Choose the model on the settings page
# from IDs returned by the service's /models endpoint.
# EMBEDDING_ENGINE='generic-openai'
# EMBEDDING_BASE_PATH='http://embedding-service:8000/v1' # URL reachable from the app container.
# GENERIC_OPEN_AI_EMBEDDING_API_KEY='unused' # Optional if the service requires authentication.
# EMBEDDING_MODEL_PREF= # Can be selected in /settings/embedding-preference.
# EMBEDDING_MODEL_MAX_CHUNK_LENGTH=1000
# GENERIC_OPEN_AI_EMBEDDING_MAX_CONCURRENT_CHUNKS=500
# GENERIC_OPEN_AI_EMBEDDING_API_DELAY_MS=1000
# GENERIC_OPEN_AI_EMBEDDING_QUERY_PREFIX=
# GENERIC_OPEN_AI_EMBEDDING_PASSAGE_PREFIX=

###########################################
######### Local LLM via llama.cpp #########
###########################################
# llama-server from docker/docker-compose.llamacpp.yml. That overlay already sets
# these four for you, so /settings/llm-preference comes up pointed at it with
# nothing to fill in. Uncomment one only to override the default it would use -
# a key present here always wins, and Settings writes here when you save.
# See docker/llamacpp/README.md.
# LLM_PROVIDER='generic-openai'
# GENERIC_OPEN_AI_BASE_PATH='http://llamacpp:8080/v1'
# GENERIC_OPEN_AI_MODEL_PREF='nexus-llm'
# GENERIC_OPEN_AI_MODEL_TOKEN_LIMIT='' # follows LLAMACPP_CTX; set only to override
# GENERIC_OPEN_AI_MAX_TOKENS='4096' # longest answer the model may produce

# Settings for the llama.cpp service itself, all optional.
# LLAMACPP_IMAGE_TAG='server-cuda' # server-cuda | server-vulkan | server (CPU)
# LLAMACPP_MODEL='unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M' # pulled from Hugging Face by name
# To load a GGUF you already have instead, mount its directory, name the file,
# and blank the pull above - set empty, it wins over a local file otherwise.
# LLAMACPP_MODELS_DIR='/path/to/your/gguf/folder'
# LLAMACPP_MODEL=''
# LLAMACPP_MODEL_FILE='/models/your-model.gguf' # path inside the container
# LLAMACPP_CTX='8192' # raised to 16384 by install.sh on a machine with 64GB+
# LLAMACPP_GPU_LAYERS='999' # lower it to keep some layers off a small GPU
# LLAMACPP_PUBLISH_PORT='8082' # host port for reaching the service directly
# LLAMACPP_API_KEY='' # set this and GENERIC_OPEN_AI_API_KEY together if you publish the port

# Serving several models at once, from docker/docker-compose.llamacpp-models.yml.
# Adds llama-server's router mode: every model below is advertised and loaded on
# demand, so each workspace can pick its own from the dropdown. ~37GB of weights
# at the defaults. Leave GENERIC_OPEN_AI_MODEL_PREF unset or pick one of these
# names rather than 'nexus-llm', which router mode does not use.
# For a quick three-model test (~1.17GB), layer docker-compose.llamacpp-quick-test.yml
# last instead of changing these settings. See docker/llamacpp/README.md.
# LLAMACPP_MODELS='qwen3.8-27b,gpt-oss-20b,gemma-4-12b' # or any subset
# How many of them may be in memory at the same time. One means a workspace on a
# different model waits for a reload; one per model means it never does. The
# value here is the safe one for a workstation GPU - install.sh raises it to the
# number of models on a machine with 64GB or more, which is every DGX Spark.
# LLAMACPP_MODELS_MAX='1'
# LLAMACPP_QWEN_FILE='Qwen3.8-27B-UD-Q4_K_M.gguf' # another quant from the same repo
# LLAMACPP_GPTOSS_FILE=''
# LLAMACPP_GEMMA_FILE=''

# The local services live in their own overlay files, so they normally take an
# extra -f flag each:
#   docker compose -f docker-compose.yml -f docker-compose.llamacpp.yml -f docker-compose.llamacpp-models.yml -f docker-compose.sdcpp.yml -f docker-compose.speech.yml up -d
# Uncomment these two to fold them into every plain `docker compose` command in
# this directory instead. COMPOSE_PATH_SEPARATOR is what keeps the ':' working on
# Windows, where compose would otherwise expect ';'.
# COMPOSE_PATH_SEPARATOR=':'
# COMPOSE_FILE='docker-compose.yml:docker-compose.llamacpp.yml:docker-compose.llamacpp-models.yml:docker-compose.sdcpp.yml:docker-compose.speech.yml'

###########################################
###### Speech (STT + TTS) ################
###########################################
# Two services from docker/docker-compose.speech.yml, both speaking the
# OpenAI audio API, so both are configured as the generic-openai provider - and
# the endpoints name the compose services rather than localhost, because the
# backend reaches them across the compose network.
# See docker/speech/README.md.

# The docker-compose.speech.yml overlay sets all of these for you, so
# /settings/audio-preference comes up pointed at both services. Uncomment one
# only to override - a key present here always wins.
#
# Speech to text: typhoon-whisper, MIT licensed.
# STT_PROVIDER='generic-openai'
# STT_OPEN_AI_COMPATIBLE_ENDPOINT='http://stt:8000/v1'
# STT_OPEN_AI_COMPATIBLE_MODEL='typhoon-whisper'
# STT_OPEN_AI_COMPATIBLE_KEY='' # only if you set STT_API_KEY below

# Text to speech: VoxCPM2, Apache-2.0 and permitted for commercial use. It
# supports Thai, English, Japanese and 27 other languages. It clones a voice
# from a reference clip you supply, so VOICE_MODEL is the name of a file in
# docker/speech/voices, not one of OpenAI's voice names.
# TTS_PROVIDER='generic-openai'
# TTS_OPEN_AI_COMPATIBLE_ENDPOINT='http://tts:8000/v1'
# TTS_OPEN_AI_COMPATIBLE_MODEL='voxcpm2'
# TTS_OPEN_AI_COMPATIBLE_VOICE_MODEL='female' # male or female from docker/speech/voices
# TTS_OPEN_AI_COMPATIBLE_KEY='' # only if you set TTS_API_KEY below

# Settings for the two services themselves, all optional.
# SPEECH_TORCH_INDEX_URL='https://download.pytorch.org/whl/cu130' # CUDA 13 parts, e.g. a DGX Spark
# STT_MODEL_ID='typhoon-ai/typhoon-whisper-turbo' # smaller and faster than the large-v3 default
# STT_LANGUAGE='th' # set empty to let Whisper detect the language
# STT_PUBLISH_PORT='7871'
# TTS_VOICES_DIR='./speech/voices' # host directory holding <name>.wav + <name>.txt
# TTS_DEFAULT_VOICE='female'
# TTS_PUBLISH_PORT='7872'
# TTS_MODEL_ID='openbmb/VoxCPM2'
# TTS_DEVICE='auto'
# TTS_CFG_VALUE='2.0'
# TTS_INFERENCE_TIMESTEPS='10'
# TTS_NORMALIZE_TEXT='true'
# TTS_LOAD_DENOISER='false' # keep off unless ZipEnhancer licensing is reviewed separately
# STT_API_KEY=''
# TTS_API_KEY=''

###########################################
######## Image Generation Selection #######
###########################################
# The /img command uses FLUX.1-schnell Q8 through the LocalAI-compatible API
# provided by stable-diffusion.cpp. The sdcpp Compose overlay sets the provider
# and URL; the Settings page shows the model but cannot change it.
# IMAGE_GEN_SIZE_PREF='1024x1024' # optional
# IMAGE_GEN_LOCALAI_BASE_PATH='http://sdcpp:8080/v1' # optional override
# IMAGE_GEN_LOCALAI_API_KEY='localai-api-key' # optional

# Settings for the stable-diffusion.cpp service itself, all optional.
# SDCPP_IMAGE_TAG='master-cuda' # master-cuda | master-cuda-spark (DGX Spark) | master-vulkan
# The diffusion model is fixed to flux1-schnell-Q8_0.gguf.
# SDCPP_T5XXL='t5xxl-Q8_0.gguf' # saves 4.6GB over the default fp16 encoder
# SDCPP_BACKEND='te=cpu' # default: run the T5 prompt encoder on CPU to leave GPU memory for FLUX
# SDCPP_STEPS='4'
# SDCPP_PUBLISH_PORT='7861' # host port for reaching the service directly

###########################################
######## Vector Database Selection ########
###########################################
# Configure the provider and its connection values here. The Vector Database
# settings page only displays the active provider; it cannot change these values.
# Restart the app after editing this file. Changing providers does not migrate
# existing embeddings, so plan to re-embed documents in the new database.
# Enable all below if you are using vector database: LanceDB.
# VECTOR_DB="lancedb"

# Enable all below if you are using vector database: PGVector.
# VECTOR_DB="pgvector"
# PGVECTOR_CONNECTION_STRING="postgresql://dbuser:dbuserpass@localhost:5432/yourdb"
# PGVECTOR_TABLE_NAME="nexusai_vectors" # optional, but can be defined

# Enable all below if you are using vector database: Chroma.
# VECTOR_DB="chroma"
# CHROMA_ENDPOINT='http://host.docker.internal:8000'
# CHROMA_API_HEADER="X-Api-Key"
# CHROMA_API_KEY="sk-123abc"

# Enable all below if you are using vector database: Chroma Cloud.
# VECTOR_DB="chromacloud"
# CHROMACLOUD_API_KEY="ck-your-api-key"
# CHROMACLOUD_TENANT=
# CHROMACLOUD_DATABASE=

# Enable all below if you are using vector database: Pinecone.
# VECTOR_DB="pinecone"
# PINECONE_API_KEY=
# PINECONE_INDEX=

# Enable all below if you are using vector database: Weaviate.
# VECTOR_DB="weaviate"
# WEAVIATE_ENDPOINT="http://localhost:8080"
# WEAVIATE_API_KEY=

# Enable all below if you are using vector database: Qdrant.
# VECTOR_DB="qdrant"
# QDRANT_ENDPOINT="http://localhost:6333"
# QDRANT_API_KEY=

# Enable all below if you are using vector database: Milvus.
# VECTOR_DB="milvus"
# MILVUS_ADDRESS="http://localhost:19530"
# MILVUS_USERNAME=
# MILVUS_PASSWORD=

# Enable all below if you are using vector database: Zilliz Cloud.
# VECTOR_DB="zilliz"
# ZILLIZ_ENDPOINT="https://sample.api.gcp-us-west1.zillizcloud.com"
# ZILLIZ_API_TOKEN=api-token-here

# Enable all below if you are using vector database: Astra DB.
# VECTOR_DB="astra"
# ASTRA_DB_APPLICATION_TOKEN=
# ASTRA_DB_ENDPOINT=

###########################################
######## Audio Model Selection ############
###########################################
# (default) use built-in whisper-large model, included in the Docker image.
# WHISPER_PROVIDER="local"

# use any OpenAI compatible transcription endpoint.
# WHISPER_PROVIDER="generic-openai"
# WHISPER_GENERIC_OPEN_AI_BASE_URL="http://localhost:8000/v1"
# API key is optional for endpoints without authentication.
# WHISPER_GENERIC_OPEN_AI_API_KEY=sk-xxxxxxxx
# WHISPER_GENERIC_OPEN_AI_MODEL="your-transcription-model-id"

###########################################
######## TTS/STT Model Selection ##########
###########################################
# Only OpenAI-compatible STT and TTS services are supported. Configure their
# endpoints and models here. The app can change only the TTS voice.
# TTS_PROVIDER="generic-openai"
# TTS_OPEN_AI_COMPATIBLE_KEY=sk-example
# TTS_OPEN_AI_COMPATIBLE_MODEL=tts-1
# TTS_OPEN_AI_COMPATIBLE_VOICE_MODEL=nova
# TTS_OPEN_AI_COMPATIBLE_ENDPOINT="https://api.openai.com/v1"

# STT_PROVIDER="generic-openai"
# STT_OPEN_AI_COMPATIBLE_KEY=sk-example
# STT_OPEN_AI_COMPATIBLE_MODEL=whisper-1
# STT_OPEN_AI_COMPATIBLE_ENDPOINT="https://api.openai.com/v1"

###########################################
##### FIRST-DEPLOY ADMIN ACCOUNT ##########
###########################################
# The instance needs a system administrator to sign in as. Set
# these to have that account created automatically on the first boot of a fresh deploy -
# ideal for unattended/docker deployments. If they are left unset, the onboarding screen
# asks for the same details instead.
# These are only ever applied when the instance has no accounts at all; on an instance
# that already has users they are ignored, so they cannot be used to mint a second admin.
# ADMIN_USERNAME="admin"      # lowercase, 2-64 chars, starts with a letter
# ADMIN_PASSWORD="hunter2!"   # must satisfy the password complexity rules below
# ADMIN_EMAIL="admin@example.com" # (optional) defaults to <username>@example.local

###########################################
######## PASSWORD COMPLEXITY ##############
###########################################
# Enforce a password schema for your organization users.
# Documentation on how to use https://github.com/kamronbatman/joi-password-complexity
# Default is only 8 char minimum
# PASSWORDMINCHAR=8
# PASSWORDMAXCHAR=250
# PASSWORDLOWERCASE=1
# PASSWORDUPPERCASE=1
# PASSWORDNUMERIC=1
# PASSWORDSYMBOL=1
# PASSWORDREQUIREMENTS=4

###########################################
######## ENABLE HTTPS SERVER ##############
###########################################
# By enabling this and providing the path/filename for the key and cert,
# the server will use HTTPS instead of HTTP.
#ENABLE_HTTPS="true"
#HTTPS_CERT_PATH="sslcert/cert.pem"
#HTTPS_KEY_PATH="sslcert/key.pem"

