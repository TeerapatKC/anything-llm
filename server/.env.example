SERVER_PORT=3001
JWT_SECRET="my-random-string-for-seeding" # Signs user session tokens. Please generate random string at least 12 chars long.
# JWT_EXPIRY="30d" # (optional)
SIG_KEY='passphrase' # Please generate random string at least 32 chars long.
SIG_SALT='salt' # Please generate random string at least 32 chars long.

# Backend-only brand identity preamble prepended to every chat/agent system prompt.
# Never shown in the UI - users cannot see or edit it from the Default System Prompt page.
# BRAND_IDENTITY_PROMPT="You are NexusAI, ..."
# DISABLE_BRAND_IDENTITY_PROMPT="true" # Turn the preamble off entirely.

###########################################
######## LINE Messaging Webhook ###########
###########################################
# Lets a LINE Official Account forward messages to a NexusAI workspace and
# reply with its response. The channel access token and channel secret are
# entered from Settings > Channels > LINE (not set here as env vars) since they
# need to be verified against LINE's API and stored encrypted at rest.
#
# (optional, recommended) A random string appended to the webhook path, e.g.
# /api/webhooks/line/<this value>. Every other path 404s, so scanners sweeping
# for webhook endpoints can't even find this one to attack. Generate one with
# `openssl rand -hex 20` or similar - treat it as a secret, not a display name.
# LINE_WEBHOOK_SECRET=

###########################################
######## LLM API SELECTION ################
###########################################
# Only the Generic OpenAI-compatible LLM service is supported.
# LLM_PROVIDER='generic-openai'
# Local Docker llama.cpp: http://localhost:8082/v1. Remote test example:
# GENERIC_OPEN_AI_BASE_PATH='https://llama-cpp.zenflowai.app/v1'
# GENERIC_OPEN_AI_MODEL_PREF='qwen27b' # Must match an ID returned by /models.
# GENERIC_OPEN_AI_API_KEY='unused' # Replace if the service requires authentication.
# GENERIC_OPEN_AI_ALLOWED_MODELS= # Optional comma-separated filter; blank shows every live model.
# GENERIC_OPEN_AI_MODEL_TOKEN_LIMIT=4096

###########################################
######## Embedding API Selection ##########
###########################################
# Choose one provider in the server environment. The settings page cannot change it.
# Built-in uses MintplexLabs/multilingual-e5-small, bundled into the Docker image at build time.
# EMBEDDING_ENGINE='native'

# Generic OpenAI-compatible embedding service. Choose the model on the settings page
# from IDs returned by the service's /models endpoint.
# EMBEDDING_ENGINE='generic-openai'
# EMBEDDING_BASE_PATH='http://127.0.0.1:8000/v1'
# GENERIC_OPEN_AI_EMBEDDING_API_KEY='unused' # Optional if the service requires authentication.
# EMBEDDING_MODEL_PREF= # Can be selected in /settings/embedding-preference.
# EMBEDDING_MODEL_MAX_CHUNK_LENGTH=1000
# GENERIC_OPEN_AI_EMBEDDING_MAX_CONCURRENT_CHUNKS=500
# GENERIC_OPEN_AI_EMBEDDING_API_DELAY_MS=1000
# GENERIC_OPEN_AI_EMBEDDING_QUERY_PREFIX=
# GENERIC_OPEN_AI_EMBEDDING_PASSAGE_PREFIX=

###########################################
######## Image Generation Selection #######
###########################################
# Used by the /img chat command.
# Image generation uses its own dedicated credentials so they never collide with
# the LLM/embedder provider keys above (you can point image generation at a
# different endpoint or key than your LLM).
# IMAGE_GEN_PROVIDER='openai' # openai | ollama | lemonade | openrouter | localai
# IMAGE_GEN_MODEL_PREF='gpt-image-1'
# IMAGE_GEN_SIZE_PREF='1024x1024' # optional - defaults to 1024x1024

# Only set the credentials for the provider selected above.
# IMAGE_GEN_OPENAI_KEY='sk-xxxxxx'
# IMAGE_GEN_OPENROUTER_API_KEY='sk-or-xxxxxx'
# IMAGE_GEN_OLLAMA_BASE_PATH='http://127.0.0.1:11434'
# IMAGE_GEN_OLLAMA_AUTH_TOKEN='ollama-auth-token' # optional
# IMAGE_GEN_LEMONADE_BASE_PATH='http://127.0.0.1:8000'
# IMAGE_GEN_LEMONADE_API_KEY='lemonade-api-key' # optional
# IMAGE_GEN_LOCALAI_BASE_PATH='http://127.0.0.1:8080/v1'
# IMAGE_GEN_LOCALAI_API_KEY='localai-api-key' # optional

###########################################
######## Vector Database Selection ########
###########################################
# The Vector Database settings page is read-only. Select the provider and set
# its connection values here, then restart the server. Changing providers does
# not migrate existing embeddings; re-embed documents in the new database.
# Enable all below if you are using vector database: Chroma.
# VECTOR_DB="chroma"
# CHROMA_ENDPOINT='http://localhost:8000'
# CHROMA_API_HEADER="X-Api-Key"
# CHROMA_API_KEY="sk-123abc"

# Enable all below if you are using vector database: Chroma Cloud.
# VECTOR_DB="chromacloud"
# CHROMACLOUD_API_KEY="ck-your-api-key"
# CHROMACLOUD_TENANT=
# CHROMACLOUD_DATABASE=

# Enable all below if you are using vector database: Pinecone.
# VECTOR_DB="pinecone"
# PINECONE_API_KEY=
# PINECONE_INDEX=

# Enable all below if you are using vector database: Astra DB.
# VECTOR_DB="astra"
# ASTRA_DB_APPLICATION_TOKEN=
# ASTRA_DB_ENDPOINT=

# Enable all below if you are using vector database: LanceDB.
VECTOR_DB="lancedb"

# Enable all below if you are using vector database: PG Vector.
# VECTOR_DB="pgvector"
# PGVECTOR_CONNECTION_STRING="postgresql://dbuser:dbuserpass@localhost:5432/yourdb"
# PGVECTOR_TABLE_NAME="nexusai_vectors" # optional, but can be defined

# Enable all below if you are using vector database: Weaviate.
# VECTOR_DB="weaviate"
# WEAVIATE_ENDPOINT="http://localhost:8080"
# WEAVIATE_API_KEY=

# Enable all below if you are using vector database: Qdrant.
# VECTOR_DB="qdrant"
# QDRANT_ENDPOINT="http://localhost:6333"
# QDRANT_API_KEY=

# Enable all below if you are using vector database: Milvus.
# VECTOR_DB="milvus"
# MILVUS_ADDRESS="http://localhost:19530"
# MILVUS_USERNAME=
# MILVUS_PASSWORD=

# Enable all below if you are using vector database: Zilliz Cloud.
# VECTOR_DB="zilliz"
# ZILLIZ_ENDPOINT="https://sample.api.gcp-us-west1.zillizcloud.com"
# ZILLIZ_API_TOKEN=api-token-here

###########################################
######## Audio Model Selection ############
###########################################
# (default) use built-in whisper-large model.
WHISPER_PROVIDER="local"

# use any OpenAI-compatible transcription endpoint.
# WHISPER_PROVIDER="generic-openai"
# WHISPER_GENERIC_OPEN_AI_BASE_URL="http://localhost:8000/v1"
# API key is optional for endpoints without authentication.
# WHISPER_GENERIC_OPEN_AI_API_KEY=sk-xxxxxxxx
# WHISPER_GENERIC_OPEN_AI_MODEL="your-transcription-model-id"

###########################################
######## TTS/STT Model Selection ##########
###########################################
# Only OpenAI-compatible STT and TTS services are supported. Configure their
# endpoints and models here. The app can change only the TTS voice.
TTS_PROVIDER="generic-openai"
# TTS_OPEN_AI_COMPATIBLE_KEY=sk-example
# TTS_OPEN_AI_COMPATIBLE_MODEL=tts-1
# TTS_OPEN_AI_COMPATIBLE_VOICE_MODEL=nova
# TTS_OPEN_AI_COMPATIBLE_ENDPOINT="https://api.openai.com/v1"

STT_PROVIDER="generic-openai"
# STT_OPEN_AI_COMPATIBLE_KEY=sk-example
# STT_OPEN_AI_COMPATIBLE_MODEL=whisper-1
# STT_OPEN_AI_COMPATIBLE_ENDPOINT="https://api.openai.com/v1"

# CLOUD DEPLOYMENT VARIRABLES ONLY
# STORAGE_DIR= # absolute filesystem path with no trailing slash

# Grafana dashboards embedded under Instance Settings → Monitoring.
# GRAFANA_PUBLIC_URL is the URL the *browser* uses to reach Grafana.
# GRAFANA_DASHBOARDS is uid|title|publicToken, comma-separated. The token is optional.
# GRAFANA_PUBLIC_URL=http://localhost:3300
# GRAFANA_DASHBOARDS=nexusai-docker-overview|NexusAI - Docker Overview

###########################################
##### FIRST-DEPLOY OWNER ACCOUNT ##########
###########################################
# The instance needs an owner - the single account holding the `super-admin` role. Set
# these to have that account created automatically on the first boot of a fresh deploy -
# ideal for unattended/docker deployments. If they are left unset, the onboarding screen
# asks for the same details instead.
# These are only ever applied when the instance has no accounts at all; on an instance
# that already has users they are ignored, so they cannot be used to mint a second owner.
# ADMIN_USERNAME="admin"      # lowercase, 2-64 chars, starts with a letter
# ADMIN_PASSWORD="hunter2!"   # must satisfy the password complexity rules below
# ADMIN_EMAIL="admin@example.com" # (optional) defaults to <username>@example.local

###########################################
##### OWNER RECOVERY (BREAK GLASS) ########
###########################################
# The owner account cannot be deleted, suspended, demoted or edited from inside the
# application - that is the point of it. These two variables are the way back in if the
# account is ever lost for good, and they require access to this file, which already
# implies control of the deployment. Both are applied at boot and are idempotent, but
# remove them once they have taken effect.
#
# On a host where you can run a command instead, prefer the equivalent CLI, which does
# the same thing without a restart:
#   cd server && yarn owner whoami
#   cd server && yarn owner transfer <username>
#   cd server && yarn owner reset-password <username> <new-password>
#
# Moves ownership to this account on the next boot. The outgoing owner becomes an Admin.
# SUPER_ADMIN_TRANSFER_TO="someone-else"
# Replaces the current owner's password and clears any suspension. They are forced to
# choose a new password at their next login.
# SUPER_ADMIN_RESET_PASSWORD="temporary-password"

###########################################
######## PASSWORD COMPLEXITY ##############
###########################################
# Enforce a password schema for your organization users.
# Documentation on how to use https://github.com/kamronbatman/joi-password-complexity
#PASSWORDMINCHAR=8
#PASSWORDMAXCHAR=250
#PASSWORDLOWERCASE=1
#PASSWORDUPPERCASE=1
#PASSWORDNUMERIC=1
#PASSWORDSYMBOL=1
#PASSWORDREQUIREMENTS=4

###########################################
######## ENABLE HTTPS SERVER ##############
###########################################
# By enabling this and providing the path/filename for the key and cert,
# the server will use HTTPS instead of HTTP.
#ENABLE_HTTPS="true"
#HTTPS_CERT_PATH="sslcert/cert.pem"
#HTTPS_KEY_PATH="sslcert/key.pem"

